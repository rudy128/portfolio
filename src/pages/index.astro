---
import Desktop from '../components/desktop/Desktop.svelte';
import Layout from '../layouts/Layout.astro';
import { latestOrgCommit, latestXPost, profile, projects } from '../data/portfolio';

const presenceWsUrl = import.meta.env.PUBLIC_PRESENCE_WS_URL
	?? (import.meta.env.DEV ? 'ws://localhost:8787/presence' : '');
---

<Layout>
	<Desktop client:load {profile} {projects} {latestXPost} {latestOrgCommit} {presenceWsUrl} />
</Layout>
