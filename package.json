{
  "name": "",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "presence:dev": "wrangler dev --config presence-worker/wrangler.jsonc --port 8787",
    "presence:types": "wrangler types presence-worker/worker-configuration.d.ts --config presence-worker/wrangler.jsonc --include-runtime false",
