    "svelte": "^5.57.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@types/geojson": "7946.0.16",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.127.1"
  }
